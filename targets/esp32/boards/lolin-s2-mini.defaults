# LOLIN S2 Mini v1.0.0 (ESP32-S2FNR2, 4MB flash, 2MB PSRAM) with a PCM5102A.
#
#   idf.py -B build.lolin-s2 -DIDF_TARGET=esp32s2 -DSDKCONFIG=sdkconfig.lolin-s2 \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/lolin-s2-mini.defaults" build
CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_CSPOT_I2S_MCLK_GPIO=-1
CONFIG_CSPOT_I2S_BCLK_GPIO=10
CONFIG_CSPOT_I2S_WS_GPIO=11
CONFIG_CSPOT_I2S_DOUT_GPIO=12

CONFIG_SPIRAM=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Prefer PSRAM while reserving internal memory for DMA, task control blocks
# and objects that require it.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Reduce Wi-Fi's internal-RAM use without changing its receive window.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Give the decoder more instruction cache. Keep data cache at 8KB.
CONFIG_ESP32S2_INSTRUCTION_CACHE_16KB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_ESPTOOLPY_BEFORE_NORESET=y

# The S2 has one core; optimize playback code and firmware size.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PM_ENABLE=n

# ESP32-S2 uses level 7 for the 2.44 V brownout threshold.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# UART0 is not connected to USB on this board; use native USB CDC.
CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_ESP_CONSOLE_USB_CDC_RX_BUF_SIZE=256
CONFIG_ESP_CONSOLE_USB_CDC_SUPPORT_ETS_PRINTF=y
